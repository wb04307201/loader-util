<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.wb04307201</groupId>
        <artifactId>dynamo-spring-parent</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>dynamo-spring-test</artifactId>
    <name>dynamo-spring-test</name>
    <packaging>jar</packaging>
    <description>Spring Boot 集成测试模块：*IT 测试 + TestApp 启动器 + 可启动 demo 应用。生成 default-jar + test-jar。</description>

    <dependencies>
        <!-- starter 在 main scope：demo 应用在 main classpath 启动 -->
        <dependency>
            <groupId>io.github.wb04307201</groupId>
            <artifactId>dynamo-spring-spring-boot-starter</artifactId>
        </dependency>

        <!-- MVC + 内嵌 tomcat + jackson，供 demo 应用运行 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                同时生成 default-jar（main 代码 + demo 应用）和 test-jar（main + IT，给消费方复用）。
                消费者在 demo 项目里这样引 test-jar：
                  <dependency>
                      <groupId>io.github.wb04307201</groupId>
                      <artifactId>dynamo-spring-test</artifactId>
                      <version>1.0.0</version>
                      <type>test-jar</type>
                      <scope>test</scope>
                  </dependency>
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>test-jar</id>
                        <goals><goal>test-jar</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <!--
                spring-boot:run 找不到 main 时可用 -D 显式指定：
                  mvn spring-boot:run -pl dynamo-spring-test \
                      -Dspring-boot.run.main-class=cn.wubo.dynamo.spring.demo.DemoApp
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
